layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zjstatus-hints"
        }
    }

    tab name="Workspace" {
        pane split_direction="vertical" {
            pane focus=true
            pane stacked=true {
                pane command="lazygit" expanded=true
                pane command="yazi"
            }
        }
    }
    tab name="Terminal" {
        pane
    }
}
