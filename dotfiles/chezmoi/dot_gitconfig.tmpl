[user]
    name = Flexksx
    email = {{ .email | quote }}

[alias]
    a = add
    acm = "!git add . && git commit -m"
    cm = commit -m
    co = checkout
    cob = checkout -b
    s = status
    br = branch
    nukepull = "!git clean -df && git reset --hard HEAD"

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[push]
    autoSetupRemote = true
    default = current
    followTags = true

[pull]
    rebase = true

[init]
    defaultBranch = main

[fetch]
    prune = true
    pruneTags = true

[rebase]
    autoSquash = true
    autoStash = true

[rerere]
    enabled = true
    autoupdate = true
