{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.local/share/viqui/current/codex/protect.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking protected paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.local/share/viqui/current/codex/check.mjs\"",
            "timeout": 15,
            "statusMessage": "Running Viqui checks"
          }
        ]
      }
    ]
  }
}
