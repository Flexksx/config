{
  "version": 1,
  "enabled": true,
  "preset": "default",
  "separator": "pipe",
  "separatorFg": "default",
  "separatorBg": "default",
  "iconMode": "nerd",
  "minimalist": false,
  "terminal": {
    "widthMode": "full",
    "colorLevel": "truecolor"
  },
  "extensionStatusRow": {
    "mode": "off"
  },
  "lines": [
    [
      {
        "type": "model-provider",
        "enabled": true,
        "options": {}
      },
      {
        "type": "thinking-level",
        "enabled": true,
        "options": {
          "hideWhenEmpty": true
        }
      },
      {
        "type": "git-root",
        "enabled": true,
        "options": {
          "hideWhenEmpty": true
        }
      },
      {
        "type": "git-branch",
        "enabled": true,
        "options": {
          "hideWhenEmpty": true,
          "gitBranchDisplayStyle": "plain"
        }
      },
      {
        "type": "flex-separator",
        "enabled": true,
        "options": {}
      },
      {
        "type": "cost",
        "enabled": true,
        "options": {
          "costFormatStyle": "compact",
          "showSubscription": false
        }
      }
    ],
    [
      {
        "type": "input-tokens",
        "enabled": true,
        "options": {
          "tokenFormatStyle": "compact",
          "hideWhenZero": true
        }
      },
      {
        "type": "output-tokens",
        "enabled": true,
        "options": {
          "tokenFormatStyle": "compact",
          "hideWhenZero": true
        }
      },
      {
        "type": "context",
        "enabled": true,
        "options": {
          "contextConditionalColors": true
        }
      }
    ]
  ]
}