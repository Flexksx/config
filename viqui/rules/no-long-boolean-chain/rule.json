{
  "id": "no-long-boolean-chain",
  "scanners": [
    {
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
      ],
      "runtime": "bun",
      "entrypoint": "ts/scan.ts"
    },
    {
      "extensions": [
        ".py"
      ],
      "runtime": "python3",
      "entrypoint": "py/scan.py"
    },
    {
      "extensions": [
        ".java"
      ],
      "runtime": "bun",
      "entrypoint": "java/scan.ts"
    }
  ]
}
