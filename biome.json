{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "dotfiles/ai_agents/**/*.ts",
      "dotfiles/ai_agents/**/*.js",
      "viqui/**/*.mjs",
      "viqui/rules/*/ts/no-*.ts",
      "viqui/rules/*/scan.ts",
      "viqui/rules/*/ts/scan.ts",
      "viqui/shared/*.ts",
      "viqui/viqui.ts",
      "viqui/core/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useArrowFunction": "error"
      },
      "style": {
        "useBlockStatements": "error"
      }
    }
  },
  "plugins": ["./biome/use-arrow-functions.grit"],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["viqui/**/*.mjs", "viqui/viqui.ts", "viqui/core/*.ts"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 80
      }
    },
    {
      "includes": ["biome.json"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2
      }
    }
  ]
}
